{
  "private": true,
  "description": "Builds css/site.css from css/tailwind.css. Run these from this folder.",
  "scripts": {
    "dev": "tailwindcss -i css/tailwind.css -o css/site.css --watch",
    "build": "tailwindcss -i css/tailwind.css -o css/site.css --minify && node scripts/bump-version.mjs"
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.3.3",
    "tailwindcss": "4.3.3"
  },
  "engines": {
    "node": ">=20"
  }
}
